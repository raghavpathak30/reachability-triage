# Copy to .env (gitignored) and fill in real values. Never commit real
# secrets here -- this file documents required/optional env vars with
# placeholder values only.

# Required by src/reachability/db/session.py -- Postgres connection string
# for the triage_jobs / llm_response_cache tables.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/postgres

# Required by src/reachability/triage/llm_config.py (Phase 5) -- the real
# Groq API key. Never logged, never written to any results/ file.
GROQ_API_KEY=your-groq-api-key-here

# Optional (Phase 5 U3) -- set to "1" or "true" to bypass the Postgres-
# backed real-LLM response cache (src/reachability/triage/llm_cache.py).
# Required in any environment with no Postgres provisioned but a real
# GROQ_API_KEY set (e.g. scripts/run_real_llm_fixtures.py, the CI
# eval-real job) -- otherwise the first cache check crashes on a missing
# DATABASE_URL.
TRIAGE_LLM_CACHE_DISABLED=0

# Optional (Phase 3) -- src/reachability/triage/worker.py: seconds before
# a running job with no heartbeat is reset to queued by the reaper.
TRIAGE_STALE_JOB_TIMEOUT_SECONDS=300

# Optional (Phase 3) -- src/reachability/triage/worker.py: seconds
# between poll iterations when the queue is empty.
TRIAGE_WORKER_POLL_INTERVAL_SECONDS=1.0
