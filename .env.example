# Optional: copy to .env (gitignored). `docker compose up` works with no .env
# at all. Never commit real secrets here -- placeholder values only.

# --- docker compose ---------------------------------------------------------

# Postgres superuser password for the compose `db` service (dev-only default;
# the db port is not published to the host).
POSTGRES_PASSWORD=postgres

# Host port the api is published on (bound to 127.0.0.1 only).
API_PORT=8000

# --- LLM mode ---------------------------------------------------------------

# Which LLM client jobs use (src/reachability/triage/job_runner.py).
#   stub -- deterministic policy client, NOT a real model. This is the default
#           under docker compose; needs no API key.
#   groq -- real Groq client. Opt-in. This is also what the code uses when the
#           variable is unset outside compose.
# Any other value fails the job / the worker at startup.
TRIAGE_LLM_MODE=stub

# Required only when TRIAGE_LLM_MODE=groq (src/reachability/triage/llm_config.py).
# Never logged, never written to any results/ file.
GROQ_API_KEY=

# --- app / worker -----------------------------------------------------------

# Postgres connection string (src/reachability/db/session.py). Compose sets
# this for you; set it yourself only when running outside compose.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/postgres

# Set to "1" or "true" to bypass the Postgres-backed real-LLM response cache
# (src/reachability/triage/llm_cache.py). Needed when running a real key with
# no Postgres provisioned (scripts/run_real_llm_fixtures.py, CI eval-real).
TRIAGE_LLM_CACHE_DISABLED=0

# src/reachability/triage/worker.py: seconds before a running job whose
# updated_at has not moved is reset to queued by the reaper.
TRIAGE_STALE_JOB_TIMEOUT_SECONDS=300

# src/reachability/triage/worker.py: seconds between polls when the queue is
# empty.
TRIAGE_WORKER_POLL_INTERVAL_SECONDS=1.0

# --- smoke / demo only (docker-compose.smoke.yml) ---------------------------
# Set by scripts/smoke_compose.sh and scripts/demo.sh, not by hand: the worker
# reads offline fixture wheels instead of PyPI.
# FIXTURE_WHEELS_DIR=/path/to/wheels
# PIP_FIND_LINKS=/wheels
# PIP_NO_INDEX=1
